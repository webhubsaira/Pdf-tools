# pdfilove runs entirely in the browser: no API keys are required to build or deploy it.
# Keep this file limited to names and dummy placeholders. Real values belong in an
# ignored .env file (never in source, PRs, screenshots or logs).

# Optional: canonical origin used in sitemap.xml, robots.txt and the social share tags.
PUBLIC_SITE_URL="https://pdfilove.com"

# Optional: only needed if you later add a server-side (e.g. LibreOffice) conversion
# endpoint. Anything prefixed with VITE_ is shipped to the browser and is NOT secret.
VITE_CONVERSION_API_URL=""
